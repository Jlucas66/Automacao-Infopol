# ---------------------------------------------------------
# CONFIGURAÇÕES DO BANCO DE DADOS (POSTGRES)
# ---------------------------------------------------------
# Se estiver usando SQLite para testes, essas variáveis 
# podem ficar vazias ou comentadas.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nome_do_seu_banco
DB_USER=seu_usuario
DB_PASS=sua_senha_secreta

# ---------------------------------------------------------
# CREDENCIAIS DO SISTEMA INFOPOL
# ---------------------------------------------------------
INFOPOL_URL=https://infopol.policiacivil.pe.gov.br/
INFOPOL_USER=seu_cpf_aqui
INFOPOL_PASS=sua_senha_do_portal

# ---------------------------------------------------------
# CONFIGURAÇÕES DO ROBÔ (OPCIONAL)
# ---------------------------------------------------------
# Defina como True para rodar sem abrir a janela do Chrome
HEADLESS_MODE=False
# Tempo de espera padrão para elementos carregarem (em segundos)
WAIT_TIME=15